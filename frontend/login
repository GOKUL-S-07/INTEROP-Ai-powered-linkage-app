<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Your Password - National Digital Services Portal</title>
  <style>
    :root {
      --bg-gradient-start: #F4F6FB;
      --bg-gradient-end: #EBF0F9;
      --navy-primary: #0A2540;
      --royal-blue: #1A56DB;
      --royal-blue-hover: #1447B8;
      --accent-purple-light: #F3E8FF;
      --accent-purple-border: #D8B4FE;
      --accent-purple-text: #6B21A8;
      --text-main: #1E293B;
      --text-muted: #64748B;
      --border-color: #E2E8F0;
      --input-bg: #FFFFFF;
      --success-green: #059669;
      --success-bg: #ECFDF5;
      --card-bg: #FFFFFF;
      --focus-ring: rgba(26, 86, 219, 0.2);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    /* Portal Header Branding */
    .portal-header {
      width: 100%;
      max-width: 520px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .emblem-container {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .emblem-icon {
      width: 40px;
      height: 40px;
      background: var(--navy-primary);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
    }

    .emblem-text h1 {
      font-size: 15px;
      font-weight: 700;
      color: var(--navy-primary);
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }

    .emblem-text p {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .portal-tag {
      background: var(--accent-purple-light);
      border: 1px solid var(--accent-purple-border);
      color: var(--accent-purple-text);
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 20px;
    }

    /* Stepper Header */
    .stepper-container {
      width: 100%;
      max-width: 520px;
      background: var(--card-bg);
      border-radius: 12px;
      padding: 16px 24px;
      margin-bottom: 20px;
      box-shadow: 0 4px 20px -2px rgba(10, 37, 64, 0.05);
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .step-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .step-item.completed {
      color: var(--success-green);
    }

    .step-item.active {
      color: var(--royal-blue);
    }

    .step-badge {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
    }

    .step-item.completed .step-badge {
      background: var(--success-bg);
      color: var(--success-green);
    }

    .step-item.active .step-badge {
      background: var(--royal-blue);
      color: #FFFFFF;
      box-shadow: 0 0 0 3px var(--focus-ring);
    }

    .step-connector {
      flex: 1;
      height: 2px;
      background: var(--border-color);
      margin: 0 12px;
    }

    .step-connector.completed {
      background: var(--success-green);
    }

    /* Main Card */
    .main-card {
      width: 100%;
      max-width: 520px;
      background: var(--card-bg);
      border-radius: 16px;
      padding: 36px;
      box-shadow: 0 12px 32px -4px rgba(10, 37, 64, 0.08), 0 4px 12px -2px rgba(10, 37, 64, 0.03);
      border: 1px solid var(--border-color);
      position: relative;
      overflow: hidden;
    }

    .main-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--royal-blue) 0%, #8B5CF6 100%);
    }

    .card-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--navy-primary);
      margin-bottom: 6px;
    }

    .card-subtitle {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 28px;
      line-height: 1.5;
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--navy-primary);
      margin-bottom: 8px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .form-input {
      width: 100%;
      height: 44px;
      padding: 0 42px 0 14px;
      font-size: 14px;
      color: var(--text-main);
      background: var(--input-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      outline: none;
      transition: all 0.2s ease;
    }

    .form-input:focus {
      border-color: var(--royal-blue);
      box-shadow: 0 0 0 3px var(--focus-ring);
    }

    .eye-icon {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text-muted);
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      transition: color 0.2s ease;
    }

    .eye-icon:hover {
      color: var(--navy-primary);
    }

    /* Strength Indicator */
    .strength-wrapper {
      margin-top: 8px;
      margin-bottom: 20px;
    }

    .strength-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .strength-label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .strength-value {
      font-size: 12px;
      font-weight: 700;
      color: var(--success-green);
    }

    .strength-meter {
      height: 4px;
      width: 100%;
      background: #E2E8F0;
      border-radius: 2px;
      overflow: hidden;
      display: flex;
      gap: 4px;
    }

    .strength-segment {
      height: 100%;
      flex: 1;
      background: var(--success-green);
      border-radius: 2px;
    }

    /* Requirements Box */
    .requirements-box {
      background: #F8FAFC;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 28px;
    }

    .requirements-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .requirement-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .requirement-item.valid {
      color: var(--navy-primary);
    }

    .check-icon {
      width: 14px;
      height: 14px;
      color: var(--success-green);
      flex-shrink: 0;
    }

    /* Action Button */
    .btn-primary {
      width: 100%;
      height: 46px;
      background: var(--royal-blue);
      color: #FFFFFF;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 2px 4px rgba(26, 86, 219, 0.15);
    }

    .btn-primary:hover {
      background: var(--royal-blue-hover);
      box-shadow: 0 4px 8px rgba(26, 86, 219, 0.25);
    }

    /* Footer */
    .card-footer {
      margin-top: 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-muted);
    }

    .card-footer a {
      color: var(--royal-blue);
      text-decoration: none;
      font-weight: 600;
      margin-left: 4px;
    }

    .card-footer a:hover {
      text-decoration: underline;
    }

    /* Official Portal Footer Note */
    .portal-footer-note {
      margin-top: 24px;
      text-align: center;
      font-size: 11px;
      color: #94A3B8;
      display: flex;
      align-items: center;
      gap: 6px;
      justify-content: center;
    }

    .lock-icon {
      width: 12px;
      height: 12px;
      fill: currentColor;
    }
  </style>
</head>
<body>

  <header class="portal-header">
    <div class="emblem-container">
      <div class="emblem-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <div class="emblem-text">
        <h1>Digital India Services</h1>
        <p>National Portal Framework</p>
      </div>
    </div>
    <span class="portal-tag">Official Portal</span>
  </header>

  <div class="stepper-container">
    <div class="step-item completed">
      <div class="step-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span>1. Identity</span>
    </div>
    
    <div class="step-connector completed"></div>
    
    <div class="step-item completed">
      <div class="step-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span>2. OTP</span>
    </div>
    
    <div class="step-connector"></div>
    
    <div class="step-item active">
      <div class="step-badge">3</div>
      <span>Password</span>
    </div>
  </div>

  <main class="main-card">
    <h2 class="card-title">Create Your Password</h2>
    <p class="card-subtitle">Set a strong password to secure your government account.</p>

    <form onsubmit="event.preventDefault();">
      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <div class="input-wrapper">
          <input type="password" id="password" class="form-input" value="K8#mP$9xL2" placeholder="Enter password">
          <button type="button" class="eye-icon" aria-label="Toggle password visibility">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <div class="strength-wrapper">
        <div class="strength-header">
          <span class="strength-label">Password Strength</span>
          <span class="strength-value">Strong</span>
        </div>
        <div class="strength-meter">
          <div class="strength-segment"></div>
          <div class="strength-segment"></div>
          <div class="strength-segment"></div>
          <div class="strength-segment"></div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="confirm-password">Confirm Password</label>
        <div class="input-wrapper">
          <input type="password" id="confirm-password" class="form-input" value="K8#mP$9xL2" placeholder="Re-enter password">
          <button type="button" class="eye-icon" aria-label="Toggle password visibility">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <div class="requirements-box">
        <ul class="requirements-list">
          <li class="requirement-item valid">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>At least 8 characters</span>
          </li>
          <li class="requirement-item valid">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Mix of letters, numbers and symbols</span>
          </li>
          <li class="requirement-item valid">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Avoid easily guessable information</span>
          </li>
        </ul>
      </div>

      <button type="submit" class="btn-primary">Create Account</button>
    </form>

    <div class="card-footer">
      <span>Already have an account?</span>
      <a href="#">Login</a>
    </div>
  </main>

  <div class="portal-footer-note">
    <svg class="lock-icon" viewBox="0 0 24 24">
      <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
    </svg>
    <span>End-to-end encrypted 256-bit secure government session</span>
  </div>

</body>
</html>